# Copy to .env.local and fill from Firebase Console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: email OTP delivery (https://www.emailjs.com)
# Use the EmailJS "One-Time Password (OTP)" template (or custom).
# Dynamic vars our app sends: passcode, time, email, otp, to_email, company_name, app_name
# In the template To field use: {{email}} or {{to_email}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Required for OTP → set new password on the same screen (no Firebase reset link).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE JSON as a single line (or keep pretty JSON).
FIREBASE_SERVICE_ACCOUNT_JSON=
