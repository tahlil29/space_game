rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // OTP hashes — create only; clients verify against localStorage primarily.
    // Prefer locking this down further with App Check / Cloud Functions in production.
    match /passwordOtps/{emailKey} {
      allow create: if request.resource.data.keys().hasAll(['hash', 'expires', 'email'])
        && request.resource.data.email is string
        && request.resource.data.hash is string;
      allow get: if true;
      allow delete: if true;
      allow list, update: if false;
    }
  }
}
