rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // One-time password-reset codes (hashed). Clients create/get/delete by email key.
    match /passwordOtps/{emailKey} {
      allow create, get, delete: if true;
      allow list, update: if false;
    }
  }
}
