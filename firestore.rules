rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // OTP hashes for forgot-password (EmailJS code).
    match /passwordOtps/{emailKey} {
      allow create: if request.resource.data.keys().hasAll(['hash', 'expires', 'email'])
        && request.resource.data.email is string
        && request.resource.data.hash is string;
      allow get: if true;
      allow delete: if true;
      allow list, update: if false;
    }

    // Written after client verifies OTP — proves possession of the code to rules.
    match /otpUnlocks/{emailKey} {
      allow create: if request.resource.data.keys().hasAll(['hash', 'email', 'expires'])
        && request.resource.data.email is string
        && request.resource.data.hash is string
        && exists(/databases/$(database)/documents/passwordOtps/$(emailKey))
        && get(/databases/$(database)/documents/passwordOtps/$(emailKey)).data.hash
          == request.resource.data.hash
        && get(/databases/$(database)/documents/passwordOtps/$(emailKey)).data.expires
          > request.time.toMillis();
      allow get, delete: if true;
      allow list, update: if false;
    }

    function otpUnlocked(emailKey) {
      return exists(/databases/$(database)/documents/otpUnlocks/$(emailKey))
        && exists(/databases/$(database)/documents/passwordOtps/$(emailKey))
        && get(/databases/$(database)/documents/otpUnlocks/$(emailKey)).data.hash
          == get(/databases/$(database)/documents/passwordOtps/$(emailKey)).data.hash
        && get(/databases/$(database)/documents/passwordOtps/$(emailKey)).data.expires
          > request.time.toMillis();
    }

    // Public login material: password hash + AES wrap of the real Firebase password.
    // Useless without the player's password (or OTP access to authVault).
    match /credentials/{emailKey} {
      allow get: if true;
      allow create, update: if (
          request.auth != null
          && request.auth.token.email is string
          && request.resource.data.email == request.auth.token.email
        ) || otpUnlocked(emailKey);
      allow delete: if request.auth != null
        && request.auth.token.email is string
        && resource.data.email == request.auth.token.email;
      allow list: if false;
    }

    // Real Firebase Auth password. Readable after OTP unlock (for forgot-password).
    match /authVault/{emailKey} {
      allow create, update: if request.auth != null
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.firebasePassword is string
        && request.resource.data.firebasePassword.size() >= 6;
      allow get: if (
          request.auth != null
          && request.auth.token.email is string
          && resource.data.email == request.auth.token.email
        ) || otpUnlocked(emailKey);
      allow delete: if request.auth != null
        && request.auth.token.email is string
        && resource.data.email == request.auth.token.email;
      allow list: if false;
    }

    // Legacy recovery secret (pre-vault). Prefer authVault going forward.
    match /authSecrets/{emailKey} {
      allow create, update: if request.auth != null
        && request.auth.token.email is string
        && request.resource.data.keys().hasAll(['email', 'authPassword', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authPassword is string
        && request.resource.data.authPassword.size() >= 6;
      allow get: if (
          request.auth != null
          && request.auth.token.email is string
          && resource.data.email == request.auth.token.email
        ) || otpUnlocked(emailKey);
      allow delete: if request.auth != null
        && request.auth.token.email is string
        && resource.data.email == request.auth.token.email;
      allow list: if false;
    }
  }
}
